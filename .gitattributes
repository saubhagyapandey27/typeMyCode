# Auto-detect text files and perform LF normalization on checkin
* text=auto

# Web source files normalized to LF
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Binary media
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
